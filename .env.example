# Copy to .env; never commit .env or private documents.
DEEPSEEK_API_KEY=
# Optional overrides below. Leave commented to edit these in the UI.
# RAG_LLM_MODEL=deepseek-flash
# RAG_LLM_BASE_URL=https://api.deepseek.com
# RAG_LLM_TIMEOUT=60
# RAG_LLM_MAX_TOKENS=2048
# DeepSeek-specific. Use false with another OpenAI-compatible provider.
# RAG_DEEPSEEK_MODE=true
RAG_DATA_DIR=data/production
# Knowledge packs created by the builder; relative to the working directory.
# RAG_PACKS_DIR=knowledge_packs
# RAG_PACKS_DATA_DIR=data
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_MODEL_CACHE=.cache/models
# Pinned Hugging Face commit; keep it fixed for reproducible indexes.
# RAG_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
# RAG_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
RAG_EMBEDDING_DEVICE=cpu
# RAG_TOP_K=5
# BM25/dense candidate pool per retriever before RRF; not the final Top-K.
# RAG_RETRIEVAL_CANDIDATE_POOL=50
# Starting point only. Calibrate on your own data; not a universal cutoff.
# RAG_SIMILARITY_THRESHOLD=0.55
# Character chunks; tokenizer length is checked to prevent silent truncation.
# RAG_CHUNK_SIZE=400
# RAG_CHUNK_OVERLAP=60
# RAG_ALLOW_GENERAL=true
# RAG_SHOW_DEBUG=false
# Optional trusted teaching style; use start-lanqiao.ps1 for the course workspace.
# RAG_TEACHING_PROFILE_PATH=knowledge_packs/lanqiao_ds/profile/teaching.md
# RAG_TEACHING_PROFILE_PATH=disabled  # Explicitly disable an inherited .env profile.
# Optional same-document neighbor context (0..2); default 0.
# RAG_RETRIEVAL_CONTEXT_WINDOW=0
RAG_MAX_UPLOAD_MB=20

