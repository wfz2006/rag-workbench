# Desktop profile 0.1.11 - key-free template. Never commit a filled .env.
# Copy into user-data/.env, fill DEEPSEEK_API_KEY, then restart the app fully.
DEEPSEEK_API_KEY=
RAG_DATA_DIR=knowledge
RAG_MODEL_CACHE=models

# Short Chinese queries against English corpora score ~0.48-0.51.
RAG_SIMILARITY_THRESHOLD=0.40
RAG_TOP_K=10
RAG_RETRIEVAL_CONTEXT_WINDOW=1

# Set true to restore the general-model fallback.
RAG_ALLOW_GENERAL=false
# One extra LLM call per question; needed for Chinese -> English retrieval.
RAG_CROSS_LINGUAL_RETRIEVAL=true
# Keep parsing offline; auto may download Docling weights and invalidate indexes.
RAG_PDF_PARSER=pypdf
